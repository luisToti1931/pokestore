<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tutorial 04: datos de demostración -->
    <record id="figure_demo_pikachu" model="pokestore.figure">
        <field name="name">Pikachu Explorer</field>
        <field name="pokemon">Pikachu</field>
        <field name="collection_id" ref="pokestore.collection_kanto_classics" />
        <field name="rarity">rare</field>
        <field name="price">29.90</field>
        <field name="stock">8</field>
    </record>

    <record id="figure_demo_lugia" model="pokestore.figure">
        <field name="name">Lugia Silver Edition</field>
        <field name="pokemon">Lugia</field>
        <field name="collection_id" ref="pokestore.collection_johto_legends" />
        <field name="rarity">exclusive</field>
        <field name="price">74.50</field>
        <field name="stock">3</field>
    </record>

    <record id="figure_demo_treecko" model="pokestore.figure">
        <field name="name">Treecko Forest</field>
        <field name="pokemon">Treecko</field>
        <field name="collection_id" ref="pokestore.collection_hoenn_adventures" />
        <field name="rarity">normal</field>
        <field name="price">18.00</field>
        <field name="stock">12</field>
    </record>
</odoo>